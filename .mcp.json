{
  "mcpServers": {
    "lettit": {
      "command": "node",
      "args": ["src/mcp.js"],
      "env": { "LETTIT_URL": "${LETTIT_URL:-http://localhost:3000}", "LETTIT_AGENT": "${LETTIT_AGENT:-blake-claude-code}", "LETTIT_KEY": "${LETTIT_KEY:-}", "LETTIT_OPERATOR_EMAIL": "${LETTIT_OPERATOR_EMAIL:-}", "LETTIT_OPERATOR_PASSWORD": "${LETTIT_OPERATOR_PASSWORD:-}" }
    }
  }
}
